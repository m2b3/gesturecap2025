#N canvas 400 200 900 550 12;
#N canvas 0 0 450 300 osc_input 0;
#X obj 80 80 netreceive -u -b 11111;
#X obj 80 110 oscparse;
#X obj 80 140 list trim;
#X obj 80 170 outlet;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X restore 60 30 pd osc_input;
#X obj 60 60 route pinch;
#X obj 60 90 route distance trigger release;
#X obj 60 140 expr 200 + $f1 * 800;
#X obj 60 170 line~ 10;
#X obj 60 200 osc~;
#X obj 60 260 *~;
#X obj 60 300 lop~ 2000;
#X obj 60 340 dac~;
#X obj 250 140 line~;
#X msg 250 110 0.6 10;
#X obj 400 140 line~;
#X msg 400 110 0 200;
#X text 60 370 pinch distance (0-1) -> osc freq (200-1000Hz);
#X text 250 170 pinch trigger -> volume on;
#X text 400 170 pinch release -> fade out;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 2 1 10 0;
#X connect 2 2 12 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 7 0 8 1;
#X connect 9 0 6 1;
#X connect 10 0 9 0;
#X connect 11 0 6 1;
#X connect 12 0 11 0;
