#N canvas 400 200 900 500 12;
#N canvas 0 0 450 300 osc_input 0;
#X obj 80 80 netreceive -u -b 11111;
#X obj 80 110 oscparse;
#X obj 80 140 list trim;
#X obj 80 170 outlet;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X restore 60 30 pd osc_input;
#X obj 60 60 route velocity;
#X obj 60 90 route speed swipe;
#X obj 60 130 expr 100 + $f1 * 4900;
#X obj 60 160 lop~ 5;
#X obj 60 190 noise~;
#X obj 60 220 lop~;
#X obj 60 260 *~ 0.4;
#X obj 60 300 dac~;
#X obj 300 130 bng 25 250 50 0 empty empty swipe! 0 -10 0 12 #fc0303 #000000 #000000;
#X text 60 330 hand speed (0-1) -> filter cutoff (100-5000Hz) on noise;
#X text 300 170 swipe detected -> visual feedback;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 2 1 9 0;
#X connect 3 0 4 0;
#X connect 4 0 6 1;
#X connect 5 0 6 0;
